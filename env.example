# ViralLab environment variables
# Copy this file to .env.local for local development.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only expose a public browser-safe endpoint here.
# Never put a Supabase service-role key or private AI provider key in VITE_* variables.
VITE_AI_API_URL=

# Application
VITE_APP_NAME=ViralLab
VITE_APP_VERSION=0.2.0
